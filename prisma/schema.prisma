generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id                     String    @id @default(uuid())
  fullName               String
  mobileNumber           String    @unique
  email                  String?
  password               String
  profilePicture         String?
  dateOfBirth            DateTime?
  currentLocation        String?
  preferredLanguage      String?
  preferredPaymentMethod String?
  accountStatus          String
  nationalId             String
  nationalIdImage        String
  orders                 Order[]
  balance                ClientBalance?
}

model Technician {
  id                       String       @id @default(uuid())
  fullName                 String
  email                    String?      @unique
  password                 String
  profilePicture           String?
  idCardImage              String?
  licenseRegistrationImage String?
  profession               String
  specialty                String?
  yearsOfExperience        Int
  workArea                 String
  currentLocation          String?
  workingHours             String
  holidays                 String?
  transportation           String?
  bankAccount              String?
  eWallet                  String?
  commissionPercentage     Float        @default(0)
  averageRating            Float        @default(0)
  completedOrdersCount     Int          @default(0)
  cancelledOrdersCount     Int          @default(0)
  accountStatus            String       @default("PENDING")
  mobileNumber             String       @unique
  assignments              Assignment[]
}

model Admin {
  id            String   @id @default(uuid())
  fullName      String
  email         String   @unique
  password      String
  role          String   @default("SUPER_ADMIN")
  accountStatus String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CatalogService {
  id                 String  @id @default(uuid())
  serviceName        String
  mainCategory       String
  subcategory        String
  serviceDescription String
  illustrativeImage  String?
  initialPrice       Float?
  pricingMethod      String?
  expectedDuration   Int?
  orders             Order[]
}

model Order {
  id                 String         @id @default(uuid())
  orderCode          String @unique
  problemDescription String
  problemImage       String?
  problemVideo       String?
  serviceLocation    String
  acceptanceTime     DateTime?
  arrivalTime        DateTime?
  completionTime     DateTime?
  status             String
  cancellationReason String?
  clientId           String
  serviceId          String
  createdAt          DateTime       @default(now())
  assignments        Assignment[]
  callRecords        CallRecord[]
  complaints         Complaint[]
  followUp           FollowUp?
  client             Client         @relation(fields: [clientId], references: [id])
  service            CatalogService @relation(fields: [serviceId], references: [id])
  payments           Payment[]
  ratings            Rating[]
}

model Assignment {
  id           String     @id @default(uuid())
  orderId      String
  technicianId String
  status       String
  assignedAt   DateTime   @default(now())
  respondedAt  DateTime?
  order        Order      @relation(fields: [orderId], references: [id])
  technician   Technician @relation(fields: [technicianId], references: [id])

  @@unique([orderId, technicianId])
}

model Rating {
  id         String   @id @default(uuid())
  rating     Int
  comment    String?
  images     String?
  ratingDate DateTime @default(now())
  raterType  String
  raterId    String
  ratedType  String
  ratedId    String
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
}

model Payment {
  id                 String   @id @default(uuid())
  transactionId      String
  serviceValue       Float
  commission         Float
  tax                Float?
  technicianEarnings Float
  paymentMethod      String
  paymentStatus      String
  paymentDate        DateTime @default(now())
  referenceNumber    String?
  orderId            String
  transactionIdHash  String?  @unique
  order              Order    @relation(fields: [orderId], references: [id])
}

model Complaint {
  id                          String  @id @default(uuid())
  complainantType             String
  complainantId               String
  againstType                 String
  againstId                   String
  reason                      String
  attachments                 String?
  responsibleReviewEmployeeId String?
  complaintStatus             String
  finalDecision               String?
  orderId                     String
  order                       Order   @relation(fields: [orderId], references: [id])
}

model FollowUp {
  id                String    @id @default(uuid())
  orderId           String    @unique
  scheduledAt       DateTime
  completedAt       DateTime?
  status            String
  customerSatisfied Boolean?
  notes             String?
  order             Order     @relation(fields: [orderId], references: [id])
}

model CallRecord {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())
  callerType      String
  callerId        String?
  receiverType    String
  receiverId      String?
  department      String?
  callType        String
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?
  recordingUrl    String?
  notes           String?
  orderId         String?
  order           Order?    @relation(fields: [orderId], references: [id])
}

model LoginLog {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  userType        String
  userId          String?
  email           String?
  status          String
  ipAddress       String?
  deviceType      String?
  operatingSystem String?
  failureReason   String?
}

model TrustedDevice {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  userType        String
  userId          String
  deviceName      String?
  deviceType      String?
  operatingSystem String?
  ipAddress       String?
  trusted         Boolean   @default(true)
  lastUsedAt      DateTime?
}

model AuditLog {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  actorType       String
  actorId         String?
  targetType      String
  targetId        String?
  action          String
  description     String?
  oldData         String?
  newData         String?
  ipAddress       String?
  deviceType      String?
  operatingSystem String?
}

model ClientBalance {
  id        String   @id @default(uuid())
  clientId  String   @unique
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
}
